{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agents-plus",
  "version": "0.1.0",
  "identifier": "com.msi.agents-plus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "Agents Plus",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
